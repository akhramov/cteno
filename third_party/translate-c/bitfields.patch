         const head_field_alignment = t.headFieldAlignment(record_ty);
         var unnamed_field_count: u32 = 0;
-        for (record_ty.fields, 0..) |field, field_index| {
-            const field_loc = field.name_tok;

-            // Demote record to opaque if it contains a bitfield
-            if (field.bit_width != .null) {
-                try t.opaque_demotes.put(t.gpa, base.qt, {});
-                try t.warn(scope, field_loc, "{s} demoted to opaque type - has bitfield", .{container_kind_name});
-                break :init ZigTag.opaque_literal.init();
+        var has_bitfields = false;
+        var padding_field_count: u32 = 0;
+        var prev_end_bits: u64 = 0;
+        for (record_ty.fields, 0..) |field, field_index| {
+            const field_offset_bits = field.layout.offset_bits;
+            // Unnamed bitfields are skipped
+            if (field_offset_bits == std.math.maxInt(u64)) {
+                has_bitfields = true;
+                continue;
+            }
+            if (has_bitfields and
+                field_offset_bits > prev_end_bits)
+            {
+                const gap_bits = field_offset_bits - prev_end_bits;
+                try fields.append(t.gpa, .{
+                    .name = try std.fmt.allocPrint(t.arena, "_padding_{d}", .{padding_field_count}),
+                    .type = try t.createUnsignedIntTypeNode(gap_bits),
+                    .default_value = if (t.default_init and container_kind == .@"struct") ZigTag.zero_literal.init() else null,
+                    .alignment = null,
+                });
+                padding_field_count += 1;
             }

             var field_name = field.name.lookup(t.comp);
@@ -638,13 +652,18 @@ fn transRecordDecl(t: *Translator, scope: *Scope, record_qt: QualType) Error!voi
             }

             const field_type = field_type: {
+                if (field.bit_width.unpack()) |width| {
+                    has_bitfields = true;
+                    break :field_type try t.createBitfieldTypeNode(field.qt, width);
+                }
+
                 // Check if this is a flexible array member.
                 flexible: {
                     if (field_index != record_ty.fields.len - 1 and container_kind != .@"union") break :flexible;
                     const array_ty = field.qt.get(t.comp, .array) orelse break :flexible;
                     if (!t.isFlexibleArrayLen(array_ty.len)) break :flexible;

-                    const elem_type = t.transType(scope, array_ty.elem, field_loc) catch |err| switch (err) {
+                    const elem_type = t.transType(scope, array_ty.elem, field.name_tok) catch |err| switch (err) {
                         error.UnsupportedType => break :flexible,
                         else => |e| return e,
                     };
@@ -663,7 +682,7 @@ fn transRecordDecl(t: *Translator, scope: *Scope, record_qt: QualType) Error!voi
                     break :field_type backing_array;
                 }

-                break :field_type t.transType(scope, field.qt, field_loc) catch |err| switch (err) {
+                break :field_type t.transType(scope, field.qt, field.name_tok) catch |err| switch (err) {
                     error.UnsupportedType => {
                         try t.opaque_demotes.put(t.gpa, base.qt, {});
                         try t.warn(scope, field.name_tok, "{s} demoted to opaque type - unable to translate type of field {s}", .{
@@ -679,10 +698,11 @@ fn transRecordDecl(t: *Translator, scope: *Scope, record_qt: QualType) Error!voi
             // Demote record to opaque if it contains an opaque field
             if (t.typeWasDemotedToOpaque(field.qt)) {
                 try t.opaque_demotes.put(t.gpa, base.qt, {});
-                try t.warn(scope, field_loc, "{s} demoted to opaque type - has opaque field", .{container_kind_name});
+                try t.warn(scope, field.name_tok, "{s} demoted to opaque type - has opaque field", .{container_kind_name});
                 break :init ZigTag.opaque_literal.init();
             }

+
             // C99 introduced designated initializers for structs. Omitted fields are implicitly
             // initialized to zero. Some C APIs are designed with this in mind. Defaulting to zero
             // values for translated struct fields permits Zig code to comfortably use such an API.
@@ -691,12 +711,36 @@ fn transRecordDecl(t: *Translator, scope: *Scope, record_qt: QualType) Error!voi
             else
                 null;

+            const field_alignment = if (has_bitfields)
+                null
+            else
+                t.alignmentForField(record_ty, head_field_alignment, field_index);
+
             fields.appendAssumeCapacity(.{
                 .name = field_name,
                 .type = field_type,
-                .alignment = t.alignmentForField(record_ty, head_field_alignment, field_index),
+                .alignment = field_alignment,
                 .default_value = default_value,
             });
+            prev_end_bits = field_offset_bits + field.layout.size_bits;
+        }
+        if (has_bitfields) {
+            if (container_kind != .@"struct") {
+                try t.opaque_demotes.put(t.gpa, base.qt, {});
+                try t.warn(scope, 0, "{s} demoted to opaque type - bitfields only supported in structs", .{container_kind_name});
+                break :init ZigTag.opaque_literal.init();
+            }
+
+            const layout = record_ty.layout.?;
+            if (layout.size_bits > prev_end_bits) {
+                try fields.append(t.gpa, .{
+                    .name = try std.fmt.allocPrint(t.arena, "_padding_{d}", .{padding_field_count}),
+                    .type = try t.createUnsignedIntTypeNode(layout.size_bits - prev_end_bits),
+                    .default_value = if (t.default_init and container_kind == .@"struct") ZigTag.zero_literal.init() else null,
+                    .alignment = null,
+                });
+                padding_field_count += 1;
+            }
         }

         // A record is empty if it has no fields or only flexible array fields.
@@ -722,7 +766,8 @@ fn transRecordDecl(t: *Translator, scope: *Scope, record_qt: QualType) Error!voi
         container_payload.* = .{
             .base = .{ .tag = container_kind },
             .data = .{
-                .layout = .@"extern",
+                .layout = if (has_bitfields) .@"packed" else .@"extern",
+                .backing_int = if (has_bitfields) record_ty.layout.?.size_bits else null,
                 .fields = try t.arena.dupe(ast.Payload.Container.Field, fields.items),
                 .decls = try t.arena.dupe(ZigNode, functions.items),
             },
@@ -1169,6 +1214,15 @@ fn getTypeStr(t: *Translator, qt: QualType) ![]const u8 {
     return t.arena.dupe(u8, allocating.written());
 }

+fn createUnsignedIntTypeNode(t: *Translator, bits: u64) !ZigNode {
+    return ZigTag.type.create(t.arena, try std.fmt.allocPrint(t.arena, "u{d}", .{bits}));
+}
+
+fn createBitfieldTypeNode(t: *Translator, field_qt: QualType, width_bits: u64) !ZigNode {
+    if (width_bits == 1 and field_qt.is(t.comp, .bool)) return ZigTag.type.create(t.arena, "bool");
+    return t.createUnsignedIntTypeNode(width_bits);
+}
+
 fn transType(t: *Translator, scope: *Scope, qt: QualType, source_loc: TokenIndex) TypeError!ZigNode {
     switch (qt.type(t.comp)) {
         .atomic => {
@@ -1340,10 +1394,8 @@ fn alignmentForField(t: *Translator, record_decl: aro.Type.Record, head_field_al
     const parent_ptr_alignment_bits = record_decl.layout.?.pointer_alignment_bits;
     const parent_ptr_alignment = parent_ptr_alignment_bits / bits_per_byte;

-    // bitfields aren't supported yet. Until support is added, records with bitfields
-    // should be demoted to opaque, and this function shouldn't be called for them.
     if (field.bit_width != .null) {
-        @panic("TODO: add bitfield support for records");
+        @panic("This function shouldn't be called for structs with bitfields in them.");
     }

     const field_offset_bits: u64 = field.layout.offset_bits;
